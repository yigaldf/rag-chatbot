# Copy to .env and fill in. .env is gitignored.
OPENAI_API_KEY=sk-...
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Only needed to point at real AWS SQS. docker-compose defaults these to
# dummy values, because boto3 refuses to sign a request without credentials
# even against ElasticMQ, which ignores them.
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
